[Desktop Entry]
Type=Application
Name=Ophion
GenericName=Connection manager for SSH, SFTP, FTP and RDP
Comment=Organise SSH hosts, open terminals, transfer files and connect to remote desktops
Exec=ophion %U
Icon=ophion
Terminal=false
Categories=Network;RemoteAccess;
Keywords=ssh;sftp;ftp;rdp;terminal;remote;
StartupWMClass=io.github.ophion.Ophion
StartupNotify=true
X-AppImage-Name=Ophion
